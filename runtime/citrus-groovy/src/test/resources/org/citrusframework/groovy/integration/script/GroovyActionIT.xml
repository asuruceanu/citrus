<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="GroovyActionIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>This example executes groovy scripts using both inline script definition
			and external file resource.</description>
  <variables>
    <variable name="date" value="citrus:currentDate()"/>
    <variable name="greetingText" value="Hello Citrus!"/>
  </variables>
  <actions>
    <groovy>
      <script>
                println 'Hello Citrus'
            </script>
    </groovy>
    <groovy>
      <script>
                println 'Current date is ${date}!'
            </script>
    </groovy>
    <groovy>
      <script>

                    import org.citrusframework.*
                    import org.citrusframework.variable.*
                    import org.citrusframework.context.TestContext
                    import org.citrusframework.groovy.actions.GroovyAction.ScriptExecutor
                    import org.junit.jupiter.api.Assertions

                    public class GScript implements ScriptExecutor {
                        public void execute(TestContext context) {
                            Assertions.assertEquals(context.getVariable("greetingText"), "Hello Citrus!")
                            Assertions.assertEquals(context.getVariable("greetingText"), "${greetingText}")
                        }
                    }

            </script>
    </groovy>
    <groovy>
      <script>
            	println context.getVariable("date")
                assert context.getVariable("greetingText").equals("Hello Citrus!")
                assert context.getVariable("greetingText").equals("${greetingText}")
            </script>
    </groovy>
    <groovy>
      <script use-script-template="false">
                println 'Hello Citrus'
            </script>
    </groovy>
    <groovy>
      <script script-template="classpath:org/citrusframework/groovy/integration/script/custom-script-template.groovy">

                  Assertions.assertEquals(context.getVariable("scriptTemplateVar"), "It works!")
                  Assertions.assertEquals(context.getVariable("greetingText"), "Hello Citrus!")
                  Assertions.assertEquals(context.getVariable("greetingText"), "${greetingText}")

            </script>
    </groovy>
    <groovy>
      <script>

                  import org.junit.jupiter.api.Assertions

                  Assertions.assertEquals(context.getVariable("scriptTemplateVar"), "It works!")
                  Assertions.assertEquals(context.getVariable("greetingText"), "Hello Citrus!")
                  Assertions.assertEquals(context.getVariable("greetingText"), "${greetingText}")

            </script>
    </groovy>
    <groovy>
      <script>

                  public class MyCustomClass {
                    public void run() {
                        println 'Just executed a custom class with run method!'
                    }
                  }

            </script>
    </groovy>
    <groovy>
      <script file="classpath:org/citrusframework/groovy/integration/script/example.groovy"/>
    </groovy>
  </actions>
</test>
