<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="ParallelFailureIT" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <actions>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException" message="Text did not match">
      <when>
        <parallel>
          <actions>
            <echo>
              <message>Test failure in call template</message>
            </echo>
            <apply-template name="textMatchException" file="classpath:org/citrusframework/groovy/integration/container/ParallelFailureIT-textMatchException.xml">
              <parameters>
                <parameter name="text1" value="123"/>
                <parameter name="text2" value="456"/>
              </parameters>
            </apply-template>
          </actions>
        </parallel>
      </when>
    </assert>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException" message="@startsWith('Assertion failed')@">
      <when>
        <parallel>
          <actions>
            <echo>
              <message>Test failure in call template</message>
            </echo>
            <apply-template name="textMatchAssertion" file="classpath:org/citrusframework/groovy/integration/container/ParallelFailureIT-textMatchAssertion.xml">
              <parameters>
                <parameter name="text1" value="123"/>
                <parameter name="text2" value="456"/>
              </parameters>
            </apply-template>
          </actions>
        </parallel>
      </when>
    </assert>
  </actions>
</test>
