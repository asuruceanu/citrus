<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="TemplateVariablesIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test makes sure variables are updated during test with template usage.</description>
  <variables>
    <variable name="user1" value="Christoph"/>
    <variable name="user2" value="Julia"/>
    <variable name="userName" value=""/>
  </variables>
  <actions>
    <create-variables>
      <variable name="userName" value="citrus:concat('My name is ', ${user1})"/>
    </create-variables>
    <apply-template name="doIt" file="classpath:org/citrusframework/groovy/integration/container/TemplateVariablesIT-doIt.xml">
      <parameters>
        <parameter name="expected" value="${user1}"/>
      </parameters>
    </apply-template>
    <create-variables>
      <variable name="userName" value="citrus:concat('My name is ', ${user2})"/>
    </create-variables>
    <apply-template name="doIt" file="classpath:org/citrusframework/groovy/integration/container/TemplateVariablesIT-doIt.xml">
      <parameters>
        <parameter name="expected" value="${user2}"/>
      </parameters>
    </apply-template>
  </actions>
</test>
