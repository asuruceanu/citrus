<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="TemplateIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="text" value="Hello TestFramework"/>
  </variables>
  <actions>
    <apply-template name="doCreateVariables" file="classpath:org/citrusframework/testng/integration/container/TemplateIT-doCreateVariables.xml"/>
    <apply-template name="doTraceVariables" file="classpath:org/citrusframework/testng/integration/container/TemplateIT-doTraceVariables.xml"/>
    <apply-template name="print" file="classpath:org/citrusframework/testng/integration/container/TemplateIT-print.xml">
      <parameters>
        <parameter name="param1" value="Test1"/>
        <parameter name="param2" value="${text}"/>
      </parameters>
    </apply-template>
    <parallel>
      <actions>
        <apply-template name="print" file="classpath:org/citrusframework/testng/integration/container/TemplateIT-print.xml">
          <parameters>
            <parameter name="param1" value="1"/>
            <parameter name="param2" value="Hello World"/>
          </parameters>
        </apply-template>
        <apply-template name="print" file="classpath:org/citrusframework/testng/integration/container/TemplateIT-print.xml">
          <parameters>
            <parameter name="param1" value="2"/>
            <parameter name="param2">
              <value><![CDATA[
                      <HelloRequest xmlns="http://citrusframework.org/schemas/samples/sayHello.xsd">
                         <Text>Hello South ${var}</Text>
                      </HelloRequest>
                    ]]></value>
            </parameter>
          </parameters>
        </apply-template>
        <apply-template name="print" file="classpath:org/citrusframework/testng/integration/container/TemplateIT-print.xml">
          <parameters>
            <parameter name="param1" value="3"/>
            <parameter name="param2" value="Hello North"/>
          </parameters>
        </apply-template>
      </actions>
    </parallel>
    <trace-variables/>
  </actions>
</test>
