<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Citrus" name="HelloService_Ok_IT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="message" value="Hello Citrus!"/>
  </variables>
  <actions>
    <echo>
      <message>Send JMS request message to queue destination</message>
    </echo>
    <send endpoint="helloJmsEndpoint">
      <message>
        <headers>
          <header name="Operation" value="HelloService/sayHello"/>
        </headers>
        <body>
          <data><![CDATA[<hello:HelloRequest xmlns:hello="http://citrusframework.org/schemas/samples/HelloService">
                <hello:Message>${message}</hello:Message>
              </hello:HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <echo>
      <message>Receive JMS message on queue destination</message>
    </echo>
    <receive endpoint="helloJmsEndpoint">
      <message>
        <headers>
          <header name="Operation" value="HelloService/sayHello"/>
        </headers>
        <body>
          <data><![CDATA[<hello:HelloRequest xmlns:hello="http://citrusframework.org/schemas/samples/HelloService">
                <hello:Message>${message}</hello:Message>
              </hello:HelloRequest>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
