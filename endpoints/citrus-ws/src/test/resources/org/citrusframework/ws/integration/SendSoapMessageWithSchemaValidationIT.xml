<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Thorsten Schlathoelter" name="SendSoapMessageWithSchemaValidationIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Sending SOAP messages with schema validation of the sent message</description>
  <actions>
    <echo>
      <message>Test: Sending valid SOAP message</message>
    </echo>
    <parallel>
      <actions>
        <send endpoint="echoSoapClient">
          <message schema-validation="true">
            <body>
              <data><![CDATA[<sample:sampleMessage xmlns:sample="http://citrusframework.org/SampleService/">
                  <command>hello</command>
                  <message>FOO</message>
                </sample:sampleMessage>]]></data>
            </body>
          </message>
        </send>
        <sequential>
          <actions>
            <receive endpoint="echoSoapServer">
              <message schema-repository="sampleServiceSchemaRepository">
                <body>
                  <data><![CDATA[<sample:sampleMessage xmlns:sample="http://citrusframework.org/SampleService/">
                    <command>hello</command>
                    <message>FOO</message>
                  </sample:sampleMessage>]]></data>
                </body>
              </message>
            </receive>
            <send endpoint="echoSoapServer">
              <message>
                <body>
                  <data><![CDATA[<sample:sampleMessageResponse xmlns:sample="http://citrusframework.org/SampleService/">
                    <response>success</response>
                    <message>BAR</message>
                  </sample:sampleMessageResponse>]]></data>
                </body>
              </message>
            </send>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <receive endpoint="echoSoapClient">
      <message schema-repository="sampleServiceSchemaRepository">
        <body>
          <data><![CDATA[<sample:sampleMessageResponse xmlns:sample="http://citrusframework.org/SampleService/">
                <response>success</response>
                <message>BAR</message>
              </sample:sampleMessageResponse>]]></data>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test: Sending invalid SOAP message</message>
    </echo>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <send endpoint="echoSoapClient">
          <message schema-validation="true">
            <body>
              <data><![CDATA[<sample:sampleMessage xmlns:sample="http://citrusframework.org/SampleService/">
                  <command>hello</command>
                  <message>FOO-wrong</message>
                </sample:sampleMessage>]]></data>
            </body>
          </message>
        </send>
      </when>
    </assert>
  </actions>
</test>
