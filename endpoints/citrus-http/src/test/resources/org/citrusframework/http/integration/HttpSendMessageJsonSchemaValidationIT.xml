<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Thorsten Schlathoelter" name="HttpSendMessageJsonSchemaValidationIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Tests the sent message on schema validity</description>
  <actions>
    <echo>
      <message>Test: Send a request and successfully validate it's request message against json schema
                </message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <PUT schema-validation="true" type="json">
          <body>
            <data>[
                            {
                            "id": 2,
                            "name": "An ice sculpture",
                            "price": 12.50,
                            "tags": ["cold", "ice"],
                            "dimensions": {
                            "length": 7.0,
                            "width": 12.0,
                            "height": 9.5
                            }
                            }
                            ]</data>
          </body>
        </PUT>
      </send-request>
    </http>
    <http server="echoHttpServer">
      <receive-request>
        <PUT schema-validation="false"/>
      </receive-request>
    </http>
    <http server="echoHttpServer">
      <send-response>
        <response>
          <body>
            <data/>
          </body>
        </response>
      </send-response>
    </http>
    <http client="echoHttpClient">
      <receive-response>
        <response/>
      </receive-response>
    </http>
    <echo>
      <message>Test: Detect an invalid json message send to the server</message>
    </echo>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <http client="echoHttpClient">
          <send-request>
            <PUT schema-validation="true" type="json">
              <body>
                <data>[
                                    {
                                    "name": "An ice sculpture",
                                    "price": 12.50,
                                    "tags": ["cold", "ice"],
                                    "dimensions": {
                                    "length": 7.0,
                                    "width": 12.0,
                                    "height": 9.5
                                    }
                                    }
                                    ]</data>
              </body>
            </PUT>
          </send-request>
        </http>
      </when>
    </assert>
  </actions>
</test>
