<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="HttpParallelRequest_2_IT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>The simple HttpServer implementation is launched and requests are sent in parallel to the server destination.</description>
  <variables>
    <variable name="custom_header_id" value="123456789"/>
    <variable name="overallIterations" value="10"/>
  </variables>
  <actions>
    <parallel>
      <actions>
        <iterate condition="i lt= ${overallIterations}" index="i">
          <actions>
            <echo>
              <message>Sending request message #${i}</message>
            </echo>
            <http client="http://localhost:12080/test?endpointName=echoHttpClient${i}">
              <send-request fork="true">
                <POST accept="application/xml" content-type="application/xml">
                  <headers>
                    <header name="CustomHeaderId" value="${custom_header_id}"/>
                  </headers>
                  <body>
                    <data><![CDATA[<testRequestMessage>
                      <text>Hello HttpServer</text>
                    </testRequestMessage>]]></data>
                  </body>
                </POST>
              </send-request>
            </http>
          </actions>
        </iterate>
        <iterate condition="k lt= ${overallIterations}" index="k">
          <actions>
            <sequential>
              <actions>
                <http server="echoHttpServer">
                  <receive-request>
                    <POST accept="application/xml" content-type="application/xml" path="/test">
                      <headers>
                        <header name="CustomHeaderId" value="${custom_header_id}"/>
                      </headers>
                      <body>
                        <data><![CDATA[<testRequestMessage>
                            <text>Hello HttpServer</text>
                        </testRequestMessage>]]></data>
                      </body>
                    </POST>
                  </receive-request>
                </http>
                <http server="echoHttpServer">
                  <send-response>
                    <response reason-phrase="OK" status="200" version="HTTP/1.1">
                      <headers>
                        <header name="CustomHeaderId" value="${custom_header_id}"/>
                        <header name="Content-Type" value="application/xml"/>
                      </headers>
                      <body>
                        <data><![CDATA[<testResponseMessage>
                      <text>Hello Citrus</text>
                    </testResponseMessage>]]></data>
                      </body>
                    </response>
                  </send-response>
                </http>
              </actions>
            </sequential>
          </actions>
        </iterate>
        <iterate condition="j lt= ${overallIterations}" index="j">
          <actions>
            <http client="http://localhost:12080/test?endpointName=echoHttpClient${j}">
              <receive-response>
                <response reason-phrase="OK" status="200" version="HTTP/1.1">
                  <headers>
                    <header name="CustomHeaderId" value="${custom_header_id}"/>
                  </headers>
                  <body>
                    <data><![CDATA[<testResponseMessage>
                    <text>Hello Citrus</text>
                  </testResponseMessage>]]></data>
                  </body>
                </response>
              </receive-response>
            </http>
            <echo>
              <message>Successfully received response message #${j}</message>
            </echo>
          </actions>
        </iterate>
      </actions>
    </parallel>
  </actions>
</test>
