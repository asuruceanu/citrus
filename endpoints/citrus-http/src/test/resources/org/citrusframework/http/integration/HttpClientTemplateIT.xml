<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Sven Hettwer" name="HttpClientTemplateIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>This tests sends to HTTP messages to a server from within a template</description>
  <actions>
    <apply-template name="httpClient" file="classpath:org/citrusframework/http/integration/HttpClientTemplateIT-httpClient.xml">
      <parameters>
        <parameter name="id" value="123"/>
      </parameters>
    </apply-template>
    <http server="echoHttpServer">
      <receive-request>
        <GET path="/echo/idTest">
          <param name="id" value="123"/>
        </GET>
      </receive-request>
    </http>
    <http server="echoHttpServer">
      <send-response>
        <response reason-phrase="OK" status="200"/>
      </send-response>
    </http>
    <apply-template name="httpClient" file="classpath:org/citrusframework/http/integration/HttpClientTemplateIT-httpClient.xml">
      <parameters>
        <parameter name="id" value="456"/>
      </parameters>
    </apply-template>
    <http server="echoHttpServer">
      <receive-request>
        <GET path="/echo/idTest">
          <param name="id" value="456"/>
        </GET>
      </receive-request>
    </http>
    <http server="echoHttpServer">
      <send-response>
        <response reason-phrase="OK" status="200"/>
      </send-response>
    </http>
  </actions>
</test>
