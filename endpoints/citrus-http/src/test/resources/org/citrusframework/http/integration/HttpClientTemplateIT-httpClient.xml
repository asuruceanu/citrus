<?xml version="1.0" encoding="UTF-8"?>
<template xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" global-context="true" name="httpClient" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <actions>
    <echo>
      <message>ID = ${id}</message>
    </echo>
    <http client="echoHttpClient">
      <send-request>
        <GET path="/idTest?id=${id}"/>
      </send-request>
    </http>
  </actions>
</template>
